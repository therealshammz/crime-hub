# Chicago Crime Intelligence Hub - Environment Configuration
# Copy this file to .env and update values as needed

# Java Configuration
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
JAVA_HOME_HADOOP=/usr/lib/jvm/java-11-openjdk-amd64

# Hadoop Configuration
HADOOP_HOME=/opt/hadoop
HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
HADOOP_STREAMING=$(which hadoop-streaming)

# Spark Configuration
SPARK_HOME=/opt/spark
SPARK_MASTER=local[*]

# HDFS Configuration
HDFS_NAMENODE=hdfs://127.0.0.1:9000
HDFS_INPUT_PATH=/user/therealshammz/crimes/input
HDFS_OUTPUT_PATH=/user/therealshammz/crimes/output

# Data Paths
DATA_DIR=/app/dataset
OUTPUT_DIR=/app/output
VISUALIZATIONS_DIR=/app/visualizations

# API Configuration
API_HOST=0.0.0.0
API_PORT=8080

# Dashboard Configuration
DASHBOARD_PORT=8501

# Data Configuration
DATA_FILE=crimes.csv
DATA_URL=https://data.cityofchicago.org/resource/ijzp-q8t2.csv

# Model Configuration
RANDOM_SEED=42
TRAIN_SPLIT=0.8
TOP_CRIME_TYPES=10