# Git attributes for Chicago Crime Intelligence Hub

# Treat CSV files as text
*.csv text

# Treat TSV files as text
*.tsv text

# Treat JSON files as text
*.json text

# Treat Python files as text
*.py text

# Treat Markdown files as text
*.md text

# Treat YAML files as text
*.yaml text
*.yml text

# Treat TOML files as text
*.toml text

# Treat Dockerfile as text
Dockerfile text

# Treat Makefile as text
Makefile text

# Large files - use Git LFS if available
# dataset/crimes.csv filter=lfs diff=lfs merge=lfs -text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# LaTeX files
*.tex text
*.aux text
*.log text
*.out text
*.toc text
*.bbl text
*.blg text

# Set the default behavior for git diff
* text=auto

# Explicitly declare text files
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf